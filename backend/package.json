{
  "name": "syncspace-backend",
  "version": "1.0.0",
  "description": "High-concurrency backend API for SyncSpace Super App",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node src/tests/auth.test.js && node src/tests/synapse.test.js && node src/tests/task_habit.test.js && node src/tests/ledger_canvas.test.js",
    "test:auth": "node src/tests/auth.test.js",
    "test:synapse": "node src/tests/synapse.test.js",
    "test:task_habit": "node src/tests/task_habit.test.js",
    "test:ledger_canvas": "node src/tests/ledger_canvas.test.js",
    "db:migrate": "node src/db/migrate.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "syncspace",
    "express",
    "postgresql",
    "redis",
    "esmodules"
  ],
  "author": "SyncSpace Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
